# ~/.zprofile

# Mac Agent Vision Flag
# Persistent RDP takes up too much compute, park for now
MAC_AGENT_VISION=

# macOS Homebrew
if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# macOS only
if [[ "$OSTYPE" == "darwin"* ]]; then

    # SMB mount daemon (macOS only — replaces failed launchctl attempt)
    if [[ -x "$HOME/.local/bin/mount-development" ]] &&
            [[ ! $(pgrep -f "mount-development") ]]; then
        nohup "$HOME/.local/bin/mount-development" >> /tmp/mount-development.log 2>&1 &
        disown
    fi

    # Agent Vision (parked: MAC_AGENT_VISION is empty)
    if [[ "$MAC_AGENT_VISION" ]] &&
            [[ -x "$HOME/.local/bin/launch-agent-vision" ]] &&
            [[ ! $(pgrep -f "launch-agent-vision") ]]; then
        nohup "$HOME/.local/bin/launch-agent-vision" \
            >> "$HOME/Library/Logs/agent-vision.log" 2>&1 &

        disown
    fi
fi

# User scripts and binaries (saxby, mount-development, agent-vision)
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

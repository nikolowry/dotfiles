# ~/.zprofile

# macOS Homebrew
if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# macOS only
if [[ "$OSTYPE" == "darwin"* ]]; then
    # Docker Desktop
    export PATH="$PATH:$HOME/.docker/bin"

    # SMB mount daemon (macOS only — replaces failed launchctl attempt)
    if [[ -x "$HOME/.local/bin/mount-development" ]] &&
            [[ ! $(pgrep -f "mount-development") ]]; then
        nohup "$HOME/.local/bin/mount-development" >> /tmp/mount-development.log 2>&1 &
        disown
    fi

    # OpenClaw Vision
    if [[ -x "$HOME/.local/bin/launch-openclaw-vision" ]] &&
            [[ ! $(pgrep -f "launch-openclaw-vision") ]]; then
        nohup "$HOME/.local/bin/launch-openclaw-vision" \
            >> "$HOME/Library/Logs/openclaw-vision.log" 2>&1 &

        disown
    fi
fi

# User scripts and binaries (saxby, mount-development, openclaw-vision)
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
